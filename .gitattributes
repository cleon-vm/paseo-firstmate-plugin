# The quota pill's patch and its original/ and modified/ copies must stay LF,
# byte-identical to the npm package, whatever core.autocrlf says. A CRLF
# checkout of the patch does not apply to the LF files npm installs.
patches/quota-pill/** text eol=lf
# The later overlay also records LF source snapshots and a reproducible patch.
patches/status-line-reads/** text eol=lf
# Same for the steer-box fix.
patches/steer-box-click/** text eol=lf
# Same for the steer-notify overlay.
patches/steer-notify/** text eol=lf
# And the permission-broker overlay.
patches/permission-broker/** text eol=lf
# And the five older patch folders: from a CRLF checkout their patches do not
# apply to the LF files npm installs either.
patches/windows-watches/** text eol=lf
patches/files-images/** text eol=lf
patches/notification-relay/** text eol=lf
patches/reveal-in-explorer/** text eol=lf
patches/chat-input-lag/** text eol=lf
