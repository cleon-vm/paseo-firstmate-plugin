+    /** Null for an image over `MAX_IMAGE_BYTES`, with `tooLarge` set. */
+    data: z.string().nullable(),
+    tooLarge: z.boolean(),
+    size: z.number(),
+    modifiedMs: z.number(),
+  }),
+});
