+    expect(fitted.sent.map((sent) => sent.key)).toEqual(["k1", "k2"]);
+    const tiny = await fitRelayMessage(notes, 2, 10);
+    expect(tiny.sent).toHaveLength(1);
+    expect(tiny.text).toContain("dropped 2 older crew note(s)");
+  });
+});
