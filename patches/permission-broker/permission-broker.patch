+const BASE_EXEC: Permits["exec"] = [
+  { in: "scratch", prefix: ["uv", "run", "--offline", "--no-project", "python"] },
+  { in: "scratch", prefix: ["npm.cmd", "test"] },
+  { in: "notes", prefix: ["node"] },
