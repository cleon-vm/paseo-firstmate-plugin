+  "& '<home>\\data\\tools\\privacy-check.ps1' '<worktree>' origin/main",
+  "Test-Path -LiteralPath '<repo>\\README.md'",
+  "git --no-optional-locks -C '<repo>' diff HEAD~1",
+];
