+const FORBIDDEN_TOKENS = [
+  "Remove-Item x",
+  "git push",
+  "git reset --hard",
+  "cmd /c dir",
+  "Start-Process x",
+  "iex x",
+  "wsl.exe -l",
+  "Get-PnpDevice",
