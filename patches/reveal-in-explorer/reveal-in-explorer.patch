+
+/** Where a context menu was asked for, in window coordinates. */
+export interface MenuPoint {
+  x: number;
+  y: number;
+}
+
+/**
+ * Props that ask for a context menu on the view they are spread onto: a
+ * right-click on the web renderer, and a long press on native, which has no
+ * right-click. react-native-web hands `onContextMenu` from `Pressable` and
+ * `View` to the element (its forwarded props, which Paseo's own context menus
+ * rely on too), so the browser's menu is held back and `onOpen` gets the
+ * pointer. A long press is not asked for on the web, where react-native-web
+ * would take a slow mouse click for one. Right-click is not a press there, so
+ * a row's `onPress` does not also run.
+ */
+export function contextMenuProps(onOpen: (point: MenuPoint) => void): {
+  onContextMenu?: (event: unknown) => void;
+  onLongPress?: (event: GestureResponderEvent) => void;
+} {
+  if (Platform.OS !== "web") {
+    return { onLongPress: (event) => onOpen({ x: event.nativeEvent.pageX, y: event.nativeEvent.pageY }) };
+  }
+  return {
+    onContextMenu: (event) => {
+      if (typeof event !== "object" || event === null) return;
+      const x = Reflect.get(event, "clientX");
+      const y = Reflect.get(event, "clientY");
+      if (typeof x !== "number" || typeof y !== "number") return;
+      const preventDefault = Reflect.get(event, "preventDefault");
+      if (typeof preventDefault === "function") preventDefault.call(event);
+      // Only this menu: an ancestor with a menu of its own does not open one as well.
+      const stopPropagation = Reflect.get(event, "stopPropagation");
+      if (typeof stopPropagation === "function") stopPropagation.call(event);
+      onOpen({ x, y });
+    },
+  };
+}
